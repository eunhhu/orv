// status: planned-only
// contract: non-binding
// milestone: M4+
// purpose: module-system support for plan fixtures, not an MVP compile contract

pub struct Post {
  title: string
  content: string
  likes: int
  tags: {name: string}[]
  creator: User
  nullable: string?
}

pub define PostCard(post: Post) -> @article {
  @h2 "{post.title}"
  @p "{post.content}"
}
