    "source_reveal_command_count": 2,
    "selected_source_reveal_command": {
      "kind": "db",
      "provider": "postgres",
      "argv_len": 5,
      "argv_prefix": [
        "orv",
        "editor",
        "reveal"
      ],
      "source_origin_matches": true
    }
  }
}
