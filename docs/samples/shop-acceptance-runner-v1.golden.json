{
  "schema_version": 1,
  "kind": "orv.shop_acceptance.runner_inventory",
  "runner": {
    "path": "scripts/shop_acceptance_smoke.sh",
    "env": [
      {
        "marker": "ORV_BIN",
        "present": true
      },
      {
        "marker": "ORV_SHOP_ACCEPTANCE_DIR",
        "present": true
      },
      {
        "marker": "ORV_BASE_URL",
        "present": true
      },
      {
        "marker": "ORV_SHOP_ACCEPTANCE_READY_ATTEMPTS",
        "present": true
      }
    ],
    "command_order": [
      {
        "marker": "\"$ORV_BIN\" init \"$SHOP_DIR\" --template shop",
        "present": true
      },
      {
        "marker": "\"$ORV_BIN\" check .",
        "present": true
      },
      {
        "marker": "\"$ORV_BIN\" build . --prod --out dist",
        "present": true
      },
      {
        "marker": "\"$ORV_BIN\" verify-build dist",
        "present": true
      },
      {
        "marker": "\"$ORV_BIN\" deploy-env-check dist",
        "present": true
      },
      {
        "marker": "\"$ORV_BIN\" run-build dist &",
        "present": true
      },
      {
        "marker": "ORV_BIN=\"$ORV_BIN\" sh dist/deploy/smoke-test.sh",
        "present": true
      },
      {
        "marker": "\"$ORV_BIN\" benchmark-prepare dist --participants 2 > dist/deploy/benchmark-prepare.json",
        "present": true
      },
      {
        "marker": "\"$ORV_BIN\" benchmark-report dist > dist/deploy/benchmark-report.json",
        "present": true
      },
      {
        "marker": "grep -F '\"status\": \"incomplete\"' dist/deploy/benchmark-report.json",
        "present": true
      }
    ],
    "lifecycle": {
      "cleanup_trap": true,
      "kills_server_pid": true,
      "waits_for_home": true
    },
    "stdout_handoff": [
      {
        "marker": "shop acceptance smoke passed",
        "present": true
      },
      {
        "marker": "shop_dir=%s",
        "present": true
      },
      {
        "marker": "smoke_output=%s",
        "present": true
      },
      {
        "marker": "benchmark_prepare=%s",
        "present": true
      },
      {
        "marker": "benchmark_report=%s",
        "present": true
      }
    ]
  },
  "generated": {
    "commands": {
      "run_build": "orv run-build .",
      "smoke_test": "./deploy/smoke-test.sh",
      "benchmark_prepare": "orv benchmark-prepare . --participants 2",
      "benchmark_report": "orv benchmark-report .",
      "benchmark_report_require_pass": "orv benchmark-report . --require-pass"
    },
    "artifacts": {
      "participant_notes_template": "deploy/participant-notes-template.md"
    },
    "smoke_output_contract": {
      "output": "deploy/smoke-output.txt",
      "required_markers": [
        "pass_marker",
        "build_dir",
        "base_url",
        "graph_contract",
        "dap_summary",
        "dap_source_bundle",
        "server_routes",
        "trace_stream_requested"
      ]
    },
    "smoke_script": [
      {
        "marker": "orv deploy smoke test passed",
        "present": true
      },
      {
        "marker": "graph_contract=verified",
        "present": true
      },
      {
        "marker": "dap_summary=verified",
        "present": true
      },
      {
        "marker": "dap_source_bundle=verified",
        "present": true
      },
      {
        "marker": "server_routes=",
        "present": true
      },
      {
        "marker": "trace_stream_requested=%s",
        "present": true
      }
    ],
    "benchmark_evidence": {
      "artifacts_match_preflight": true,
      "benchmark_matches_preflight": true,
      "smoke_contract_matches_preflight": true,
      "participant_run_count": 1,
      "recommended_participant_count": {
        "minimum": 2,
        "target": 3
      },
      "data_to_record_has_human_review": true,
      "human_evidence_review": {
        "no_ai_assistance_confirmed": null,
        "notes": "",
        "participant_identity_reviewed": null,
        "raw_notes_reviewed": null,
        "reviewed_at": null,
        "reviewer": "",
        "smoke_output_reviewed": null
      },
      "failure_categories": [
        "syntax",
        "scaffold",
        "compiler_runtime_error",
        "editor",
        "documentation",
        "deploy_config",
        "smoke_contract",
        "other"
      ],
      "smoke_required_markers": [
        "pass_marker",
        "build_dir",
        "base_url",
        "graph_contract",
        "dap_summary",
        "dap_source_bundle",
        "server_routes",
        "trace_stream_requested"
      ]
    },
    "participant_notes_template": [
      {
        "marker": "data.participant_runs[].raw_notes_artifact",
        "present": true
      },
      {
        "marker": "participant_profile: non_developer",
        "present": true
      },
      {
        "marker": "YYYY-MM-DDTHH:MM:SSZ",
        "present": true
      },
      {
        "marker": "generated_artifact_edits: false",
        "present": true
      },
      {
        "marker": "manual_undocumented_security_steps: false",
        "present": true
      },
      {
        "marker": "ai_assistance_used: false",
        "present": true
      }
    ]
  }
}
