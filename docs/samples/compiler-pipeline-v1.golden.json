    "check": {
      "exit_success": true,
      "stdout": "check: <entry> passed\n",
      "stderr_empty": true
    },
    "run": {
      "exit_success": true,
      "stdout": "20\n8\n",
      "stderr_empty": true
    },
    "origin_calls": [
      {
        "call": "add",
        "function": "add",
