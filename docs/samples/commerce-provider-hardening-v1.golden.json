{
  "schema_version": 1,
  "kind": "orv.commerce_provider_hardening.inventory",
  "artifact": {
    "schema_version": 1,
    "kind": "orv.deploy.commerce_adapters",
    "artifact": "server/app.orv-runtime.json",
    "adapters": [
      {
        "kind": "payment",
        "mode": "provider",
        "provider": "stripe",
        "env": "PAYMENT_ADAPTER_URL",
        "default": "stripe://local",
        "endpoint": null,
        "record_path": null,
        "provider_env": [
          {
            "env": "STRIPE_API_ENDPOINT",
            "required": false,
            "purpose": "api_endpoint"
          },
          {
            "env": "STRIPE_SECRET_KEY",
            "required": true,
            "purpose": "api_secret"
          },
          {
            "env": "STRIPE_WEBHOOK_SECRET",
            "required": false,
            "purpose": "webhook_signature"
          },
          {
            "env": "STRIPE_WEBHOOK_SECRET_PREVIOUS",
            "required": false,
            "purpose": "webhook_signature_previous"
          }
        ],
        "request": {
          "method": "POST",
          "content_type": "application/json",
          "kind": "payment.capture",
          "body": {
            "kind": "payment.capture",
            "payload": "payment capture payload"
          }
        }
      },
      {
        "kind": "shipping",
        "mode": "provider",
        "provider": "carrier",
        "env": "SHIPPING_ADAPTER_URL",
        "default": "carrier://local",
        "endpoint": null,
        "record_path": null,
        "provider_env": [
          {
            "env": "CARRIER_API_ENDPOINT",
            "required": false,
            "purpose": "api_endpoint"
          },
          {
            "env": "CARRIER_API_KEY",
            "required": true,
            "purpose": "api_key"
          },
          {
            "env": "CARRIER_WEBHOOK_SECRET",
            "required": false,
            "purpose": "webhook_signature"
          }
        ],
        "request": {
          "method": "POST",
          "content_type": "application/json",
          "kind": "shipping.booking",
          "body": {
            "kind": "shipping.booking",
            "payload": "shipping booking payload"
          }
        }
      }
    ]
  },
  "source_origin_linkage": {
    "all_provider_origins_present": true
  },
  "deploy_handoff": {
    "manifest_path": "deploy/commerce-adapters.json",
    "commerce_endpoints": [],
    "commerce_env": [
      {
        "env": "PAYMENT_ADAPTER_URL",
        "default": "stripe://local"
      },
      {
        "env": "SHIPPING_ADAPTER_URL",
        "default": "carrier://local"
      }
    ],
    "container_env_matches_manifest": true,
    "container_volume_count": 0
  },
  "env_gate": {
    "required": [
      {
        "env": "STRIPE_SECRET_KEY",
        "required": true,
        "purpose": "api_secret",
        "kind": "payment",
        "provider": "stripe"
      },
      {
        "env": "CARRIER_API_KEY",
        "required": true,
        "purpose": "api_key",
        "kind": "shipping",
        "provider": "carrier"
      }
    ],
    "optional": [
      {
        "env": "STRIPE_API_ENDPOINT",
        "required": false,
        "purpose": "api_endpoint",
        "kind": "payment",
        "provider": "stripe"
      },
      {
        "env": "STRIPE_WEBHOOK_SECRET",
        "required": false,
        "purpose": "webhook_signature",
        "kind": "payment",
        "provider": "stripe"
      },
      {
        "env": "STRIPE_WEBHOOK_SECRET_PREVIOUS",
        "required": false,
        "purpose": "webhook_signature_previous",
        "kind": "payment",
        "provider": "stripe"
      },
      {
        "env": "CARRIER_API_ENDPOINT",
        "required": false,
        "purpose": "api_endpoint",
        "kind": "shipping",
        "provider": "carrier"
      },
      {
        "env": "CARRIER_WEBHOOK_SECRET",
        "required": false,
        "purpose": "webhook_signature",
        "kind": "shipping",
        "provider": "carrier"
      }
    ]
  },
  "compose": [
    {
      "marker": "PAYMENT_ADAPTER_URL: \"${PAYMENT_ADAPTER_URL:-stripe://local}\"",
      "present": true
    },
    {
      "marker": "SHIPPING_ADAPTER_URL: \"${SHIPPING_ADAPTER_URL:-carrier://local}\"",
      "present": true
    },
    {
      "marker": "STRIPE_API_ENDPOINT: \"${STRIPE_API_ENDPOINT}\"",
      "present": true
    },
    {
      "marker": "STRIPE_SECRET_KEY: \"${STRIPE_SECRET_KEY}\"",
      "present": true
    },
    {
      "marker": "STRIPE_WEBHOOK_SECRET: \"${STRIPE_WEBHOOK_SECRET}\"",
      "present": true
    },
    {
      "marker": "STRIPE_WEBHOOK_SECRET_PREVIOUS: \"${STRIPE_WEBHOOK_SECRET_PREVIOUS}\"",
      "present": true
    },
    {
      "marker": "CARRIER_API_ENDPOINT: \"${CARRIER_API_ENDPOINT}\"",
      "present": true
    },
    {
      "marker": "CARRIER_API_KEY: \"${CARRIER_API_KEY}\"",
      "present": true
    },
    {
      "marker": "CARRIER_WEBHOOK_SECRET: \"${CARRIER_WEBHOOK_SECRET}\"",
      "present": true
    }
  ],
  "env_example": [
    {
      "marker": "STRIPE_API_ENDPOINT=",
      "present": true
    },
    {
      "marker": "STRIPE_SECRET_KEY=",
      "present": true
    },
    {
      "marker": "STRIPE_WEBHOOK_SECRET=",
      "present": true
    },
    {
      "marker": "STRIPE_WEBHOOK_SECRET_PREVIOUS=",
      "present": true
    },
    {
      "marker": "CARRIER_API_ENDPOINT=",
      "present": true
    },
    {
      "marker": "CARRIER_API_KEY=",
      "present": true
    },
    {
      "marker": "CARRIER_WEBHOOK_SECRET=",
      "present": true
    }
  ],
  "runbook": [
    {
      "marker": "- Commerce adapter env: PAYMENT_ADAPTER_URL default stripe://local",
      "present": true
    },
    {
      "marker": "- Commerce adapter env: SHIPPING_ADAPTER_URL default carrier://local",
      "present": true
    },
    {
      "marker": "- Commerce provider env: payment stripe STRIPE_API_ENDPOINT optional api_endpoint",
      "present": true
    },
    {
      "marker": "- Commerce provider env: payment stripe STRIPE_SECRET_KEY required api_secret",
      "present": true
    },
    {
      "marker": "- Commerce provider env: payment stripe STRIPE_WEBHOOK_SECRET optional webhook_signature",
      "present": true
    },
    {
      "marker": "- Commerce provider env: payment stripe STRIPE_WEBHOOK_SECRET_PREVIOUS optional webhook_signature_previous",
      "present": true
    },
    {
      "marker": "- Commerce provider env: shipping carrier CARRIER_API_ENDPOINT optional api_endpoint",
      "present": true
    },
    {
      "marker": "- Commerce provider env: shipping carrier CARRIER_API_KEY required api_key",
      "present": true
    },
    {
      "marker": "- Commerce provider env: shipping carrier CARRIER_WEBHOOK_SECRET optional webhook_signature",
      "present": true
    },
    {
      "marker": "- Secret store: supply commerce provider credentials through deployment secret manager or vault values, not deploy/env.example.",
      "present": true
    },
    {
      "marker": "- Stripe webhook rotation: set STRIPE_WEBHOOK_SECRET to the new value and STRIPE_WEBHOOK_SECRET_PREVIOUS to the previous value during overlap.",
      "present": true
    },
    {
      "marker": "- Stripe replay window: STRIPE_WEBHOOK_TOLERANCE_SECONDS defaults to 300 seconds; override only with provider runbook approval.",
      "present": true
    },
    {
      "marker": "- Provider replay: payment and shipping calls use stable idempotency keys; inspect provider records before retrying checkout compensation.",
      "present": true
    }
  ]
}
